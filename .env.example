# URL base del servidor OSRM (sin "/" al final).
# El servidor demo público es solo para pruebas (límite de ~100 coordenadas y uso moderado).
OSRM_BASE_URL=https://router.project-osrm.org

# Perfil de OSRM: driving, walking, cycling (depende del servidor)
OSRM_PROFILE=driving

# Timeout en segundos para las peticiones a OSRM
OSRM_TIMEOUT_SECONDS=10
